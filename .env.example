NODE_ENV=development
PORT=4002

# Ưu tiên dùng DATABASE_URL khi deploy trên Render.
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=
DB_SSL=false

# Dùng khi chạy PostgreSQL local hoặc không có DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=mia

FE_DOMAIN_DEV=http://localhost:3000
FE_DOMAIN_PROD=https://fe-mia.onrender.com
CORS_ORIGIN_A=http://localhost:3000
CORS_ORIGIN_B=
CORS_ORIGIN_C=
# Có thể khai báo nhiều origin, ngăn cách bằng dấu phẩy.
CORS_ORIGINS=https://fe-mia.onrender.com
